{
  "name": "caldera-minesweeper",
  "version": "1.0.0",
  "description": "A modern, customizable, tactile Minesweeper for the web — no build step, no dependencies.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "start": "wrangler dev",
    "build": "node scripts/build-cloudflare.mjs",
    "deploy": "wrangler deploy",
    "check": "node --test && wrangler deploy --dry-run"
  },
  "keywords": [
    "minesweeper",
    "game",
    "vanilla-js",
    "no-build",
    "pwa",
    "accessible"
  ],
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "happy-dom": "21.0.3",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
